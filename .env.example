# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Supabase ---
# Project URL and the SERVICE ROLE key (server-to-server; bypasses RLS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, used ONLY by the LangGraph checkpointer.
# Supabase: Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URI=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- AWS Bedrock ---
# Region MUST have all 7 model ids in app/config.py:MODEL_REGISTRY enabled.
# Verify: aws bedrock list-foundation-models --region $AWS_REGION
AWS_REGION=us-east-1
# AWS credentials are read from the standard chain (env, ~/.aws/credentials, or
# instance role). Do not hardcode keys here.

# --- Tuning (optional; defaults in app/config.py) ---
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
JUDGE_MAX_ROUNDS=2
