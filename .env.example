# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Supabase ---
# Project URL and the SERVICE ROLE key (server-to-server; bypasses RLS).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string, used ONLY by the LangGraph checkpointer.
# Supabase: Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URI=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Model provider ---
# "stub"    -> no deps; canned model outputs for fast unit tests (default).
# "ollama"  -> real open-weight models running locally (no AWS, no cost, private).
# "bedrock" -> real AWS Bedrock (needs AWS creds + model access in AWS_REGION).
MODEL_PROVIDER=stub

# --- Ollama (only used when MODEL_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# One local model for all agents. Pull it first: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b

# --- AWS Bedrock (only used when MODEL_PROVIDER=bedrock) ---
# Region MUST have all 7 model ids in app/config.py:MODEL_REGISTRY enabled.
# Verify: aws bedrock list-foundation-models --region $AWS_REGION
AWS_REGION=us-east-1
# AWS credentials are read from the standard chain (env, ~/.aws/credentials, or
# instance role). Do not hardcode keys here.

# --- Tuning (optional; defaults in app/config.py) ---
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
JUDGE_MAX_ROUNDS=2

# --- Inbound webhook auth ---
# Shared secret required in the X-Webhook-Secret header on every trigger
# endpoint. Use the SAME value in the Supabase Database Webhook headers and in
# the calendar-timer scheduler. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty for local dev only — never deploy a reachable host without it.
WEBHOOK_SECRET=

# --- GitHub (Agent 7 update mode, §9.3; optional) ---
# Read-only PAT (repo:read / public_repo scope). Unauthenticated requests work
# for public repos too, just at a much lower rate limit.
GITHUB_TOKEN=
